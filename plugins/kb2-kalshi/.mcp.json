      "args": ["run", "/Users/spro/code/kb2/src/mcp/server.ts"],
      "cwd": "/Users/spro/code/kb2",
      "enabled": true,
      "default_tools_approval_mode": "approve",
      "tools": {
        "place_order": { "approval_mode": "prompt" },
