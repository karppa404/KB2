  },
  "dependencies": {
    "@perplexity-ai/perplexity_ai": "^0.3.0",
    "@libsql/client": "^0.17.3",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "kalshi-typescript": "^3.33.0",
    "zod": "^4.6.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0"
  }
